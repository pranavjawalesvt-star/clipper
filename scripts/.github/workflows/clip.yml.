name: Clip video

on:
  workflow_dispatch:
    inputs:
      video_url:
        description: "YouTube URL (leave empty if uploading a file)"
        required: false
      video_file:
        description: "Path to a file already in the repo, e.g. input/video.mp4"
        required: false

jobs:
  clip:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install tools
        run: |
          sudo apt-get update && sudo apt-get install -y ffmpeg
          pip install yt-dlp groq

      - name: Get video
        env:
          VIDEO_URL: ${{ inputs.video_url }}
          VIDEO_FILE: ${{ inputs.video_file }}
        run: |
          mkdir -p work
          if [ -n "$VIDEO_URL" ]; then
            yt-dlp -f "mp4[height<=720]/best[height<=720]" -o work/input.mp4 "$VIDEO_URL"
          else
            cp "$VIDEO_FILE" work/input.mp4
          fi

      - name: Find highlights
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        run: python scripts/pick_highlights.py work/input.mp4 work/clips.json

      - name: Cut clips
        run: python scripts/cut_clips.py work/input.mp4 work/clips.json work/out

      - uses: actions/upload-artifact@v4
        with:
          name: clips
          path: work/out/
